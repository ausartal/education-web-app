rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // AKURAT stores its data in PostgreSQL behind /api/data/* and the other API
    // routes. The browser never talks to Cloud Firestore directly, so nothing is
    // allowed here. Access control lives in src/lib/data-access.ts and in the
    // server routes; this file only makes sure a leftover Firestore database can
    // never be read or written from the client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
