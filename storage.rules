rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Uploads are handled by the server (/api/upload/image, /api/user/photo and
    // /api/exam/profile/photo) and kept on the server's own disk. Cloud Storage
    // is not used from the browser, so every path is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
